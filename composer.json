{
  "name": "entelisteam/lbaf-core",
  "description": "Universal PHP framework",
  "type": "library",
  "require": {
    "php": "~8.2",
    "nikic/fast-route": "^1.3",
    "psr/log": "^2.0 || ^3.0",
    "ext-mysqli": "*",
    "entelisteam/lbaf-hydrator": "^1.4",
    "entelisteam/lbaf-exception": "^1.2",
    "entelisteam/lbaf-mysql": "^1.2",
    "entelisteam/lbaf-consoletable": "^2.0",
    "entelisteam/lbaf-reflection": "^1.2"
  },
  "autoload": {
    "psr-4": {
      "EntelisTeam\\Lbaf\\Core\\": "src/",
      "EntelisTeam\\Lbaf\\Core\\Rector\\": "rector/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "extra": {
    "lbaf-rector-migrations": "EntelisTeam\\Lbaf\\Core\\Rector\\MigrationList"
  },
  "scripts": {
    "update:dev": "COMPOSER=dev-composer.json composer update",
    "test": "vendor/bin/phpunit",
    "rector:check": "vendor/bin/rector process --dry-run",
    "rector:fix": "vendor/bin/rector process",
    "post-update-cmd": "test ! -f vendor/bin/rector || vendor/bin/rector process"
  },
  "authors": [
    {
      "name": "ENTELISTEAM INC",
      "email": "welcome@entelis.team",
      "homepage": "https://entelis.team"
    }
  ],
  "minimum-stability": "dev",
  "require-dev": {
    "rector/rector": "^2.3.0",
    "phpunit/phpunit": "12.5.x-dev",
    "entelisteam/lbaf-rector": "^1.0"
  },
  "prefer-stable": true
}
